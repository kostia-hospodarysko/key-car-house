---
const nav = [
  { href: "#services", label: "Послуги" },
  { href: "#works", label: "Наші роботи" },
  { href: "#contacts", label: "Контакти" },
];
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="wordmark" href="#top" aria-label="На початок сторінки">
      <svg class="brand-key" viewBox="0 0 42 58" aria-hidden="true">
        <path d="M21 3a15 15 0 1 0 8.7 27.2L38 38.5l-4.8 4.8 4 4-5.8 5.8-4-4-3.7 3.7-8.9-8.9 8.4-8.4A15 15 0 0 0 21 3Zm0 8a7 7 0 1 1 0 14 7 7 0 0 1 0-14Z" fill="currentColor"/>
      </svg>
      <span>Автоключі<br /><small>Тернопіль</small></span>
    </a>

    <nav class="desktop-nav" aria-label="Головна навігація">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <button class="icon-button theme-toggle" type="button" aria-label="Перемкнути тему">
        <span class="theme-icon theme-icon-sun" aria-hidden="true">☀</span>
        <span class="theme-icon theme-icon-moon" aria-hidden="true">☾</span>
      </button>
      <a class="button button-small desktop-call" href="tel:+380962297103">Зателефонувати</a>
      <button class="icon-button menu-toggle" type="button" aria-label="Відкрити меню" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" aria-label="Мобільна навігація">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href="tel:+380962297103">+38 096 229 71 03</a>
  </nav>
</header>
