---
const services = [
  {
    title: "Дублікати ключів",
    text: "Виготовлення дублікатів автомобільних ключів різної складності.",
  },
  {
    title: "Ключі при повній втраті",
    text: "Відновимо доступ до авто та виготовимо новий ключ, навіть якщо всі ключі втрачені.",
  },
  {
    title: "Смарт-ключі",
    text: "Виготовлення, адаптація та програмування сучасних смарт-ключів.",
  },
  {
    title: "Програмування",
    text: "Прописка, адаптація та програмування ключів до автомобіля.",
  },
  {
    title: "Аварійне відкривання",
    text: "Допоможемо відкрити автомобіль без зайвого пошкодження замків.",
  },
  {
    title: "Мобільний сервіс",
    text: "Працюємо на виїзд по Тернополю та Тернопільській області.",
  },
];
---

<section class="section" id="services">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Що ми робимо</p>
        <h2>Допомога з ключами<br />в одному місці</h2>
      </div>
      <p>Від простого дубліката до відновлення ключа при повній втраті — підберемо рішення для вашого автомобіля.</p>
    </div>
    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card observe">
          <h3>{service.title}</h3>
          <p>{service.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
