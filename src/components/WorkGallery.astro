---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const works = [
  { image: `${base}/images/work/work-1.jpg`, alt: "Нові ключі для автомобіля BMW" },
  { image: `${base}/images/work/work-2.jpg`, alt: "Автомобільні ключі для синього Chevrolet" },
  { image: `${base}/images/work/work-3.jpg`, alt: "Ключі та автомобіль Mitsubishi" },
  { image: `${base}/images/work/work-4.jpg`, alt: "Ключі для автомобіля з безключовим доступом" },
  { image: `${base}/images/work/work-5.jpg`, alt: "Виготовлені ключі Toyota" },
  { image: `${base}/images/work/work-6.jpg`, alt: "Автомобільний ключ біля автомобіля" },
  { image: `${base}/images/work/work-7.jpg`, alt: "Комплект ключів для автомобіля Honda" },
  { image: `${base}/images/work/work-8.jpg`, alt: "Ключі для вантажного автомобіля MAN" },
];
---

<section class="section" id="works">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Практичний досвід</p>
        <h2>Наші роботи</h2>
      </div>
      <p>Реальні приклади виготовлення та адаптації автомобільних ключів.</p>
    </div>
    <div class="works-grid">
      {works.map((work, index) => (
        <button class:list={["work-card", { "work-featured": index === 0 }]} type="button" data-work-image={work.image} data-work-alt={work.alt}>
          <img src={work.image} alt={work.alt} loading="lazy" />
          <span class="work-caption">Виконана робота <b>↗</b></span>
        </button>
      ))}
    </div>
  </div>
</section>

<dialog class="lightbox" aria-label="Перегляд фотографії">
  <button class="lightbox-close" type="button" aria-label="Закрити">×</button>
  <img src="" alt="" />
</dialog>
