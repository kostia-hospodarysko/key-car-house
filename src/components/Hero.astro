---
const whatsapp =
  "https://wa.me/380962297103?text=%D0%92%D1%96%D1%82%D0%B0%D1%8E%21%20%D0%9F%D0%BE%D1%82%D1%80%D1%96%D0%B1%D0%BD%D0%B0%20%D0%B4%D0%BE%D0%BF%D0%BE%D0%BC%D0%BE%D0%B3%D0%B0%20%D0%B7%20%D0%B0%D0%B2%D1%82%D0%BE%D0%BC%D0%BE%D0%B1%D1%96%D0%BB%D1%8C%D0%BD%D0%B8%D0%BC%20%D0%BA%D0%BB%D1%8E%D1%87%D0%B5%D0%BC.";
---

<main id="top">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow reveal">
          <span class="status-dot"></span>
          Працюємо щодня з 09:00 до 23:00
        </div>
        <div class="hero-actions reveal delay-3">
          <a class="button button-phone" href="tel:+380962297103">+38 096 229 71 03</a>
          <a class="button button-whatsapp" href={whatsapp} target="_blank" rel="noreferrer">
            Написати у WhatsApp
          </a>
        </div>
        <h1 class="reveal delay-1">Автомобільні ключі <span>будь-якої складності</span></h1>
        <p class="hero-text reveal delay-2">
          Виготовлення, адаптація та програмування ключів. Аварійне відкривання авто з виїздом по Тернополю та області.
        </p>
      </div>

      <div class="hero-visual reveal delay-2" aria-hidden="true">
        <div class="visual-orbit orbit-one"></div>
        <div class="visual-orbit orbit-two"></div>
        <div class="service-chip chip-bottom"><strong>09:00–23:00</strong><span>щодня</span></div>
        <div class="service-chip chip-city"><strong>Тернопіль</strong><span>та вся область</span></div>
        <div class="service-chip chip-top"><strong>Виїзд</strong><span>по місту й області</span></div>
        <div class="service-chip chip-complexity"><strong>Будь-яка складність</strong><span>від дубліката до повної втрати</span></div>
      </div>
    </div>
  </section>
</main>
