---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Process from "../components/Process.astro";
import WorkGallery from "../components/WorkGallery.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

const title = "Автомобільні ключі та аварійне відкривання | Тернопіль";
const description =
  "Виготовлення, адаптація та програмування автомобільних ключів. Аварійне відкривання авто з виїздом по Тернополю та області.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <Hero />
  <Services />
  <Process />
  <WorkGallery />
  <Contact />
  <Footer />
</BaseLayout>
